# Copy this file to .env at the repository root before starting Compose.
COMPOSE_PROJECT_NAME=campus-sandbox
BACKEND_IMAGE=campus-sandbox-backend:dev
APP_ENV=development

# Host bindings. Database and Redis are exposed locally for development tools.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
API_PORT=8000
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379

# Container connection settings. These ports are internal, not published ports.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus_dev_password
POSTGRES_DB=campus
REDIS_URL=redis://redis:6379/0

# Optional override; leave empty to construct the URL from POSTGRES_* above.
# Use postgresql+asyncpg:// and URL-encode special characters if setting a URL.
DATABASE_URL=
WORKER_POLL_INTERVAL_SECONDS=1.0
EVENT_STREAM=campus:events
CONSUMER_RETRY_IDLE_MS=1000
CONSUMER_RECONCILE_INTERVAL_SECONDS=3.0

# Vite local development only; the production frontend uses Nginx /api proxy.
VITE_PROXY_TARGET=http://127.0.0.1:8000
